{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PC-Bridge",
  "version": "2.2.0",
  "identifier": "ai.pcbridge.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PC-Bridge",
        "width": 400,
        "height": 250,
        "resizable": false,
        "center": true,
        "decorations": false,
        "transparent": false,
        "visible": true,
        "theme": "Dark",
        "shadow": false,
        "maximizable": false
      },
      {
        "label": "overlay",
        "title": "pc-bridge-cursor",
        "url": "overlay.html",
        "width": 48,
        "height": 48,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
