<Window x:Class="PcBridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="PC-Bridge" Width="940" Height="760"
        MinWidth="760" MinHeight="520"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="False"
        Background="{StaticResource Bg}"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

  <!-- Whole window is client area: no white non-client band above the content. -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="14"
                  GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Border Background="{StaticResource Bg}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="34"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- title bar: drag anywhere, "─" and "✕" only -->
      <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
          <Button x:Name="MinimizeButton" Style="{StaticResource BarButton}" Content="─" Click="Minimize_Click"/>
          <Button x:Name="CloseButton" Style="{StaticResource BarButton}" Content="✕" Click="Close_Click"/>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1" Margin="18,4,18,18">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.02*"/>
          <ColumnDefinition Width="18"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Text="Доступ" FontSize="12" Foreground="{StaticResource Dim}" Margin="4,0,0,8"/>

          <!-- Карточка доступа: копирование одной иконкой в правом верхнем углу. -->
          <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="10" Padding="14,12,42,12">
            <Grid>
              <TextBox x:Name="PairingBox" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                       Foreground="{StaticResource Text}" FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                       TextWrapping="Wrap" AcceptsReturn="True" IsReadOnlyCaretVisible="False"
                       VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
                       SelectionBrush="{StaticResource Accent}" Padding="0"/>

              <Button x:Name="CardCopyButton" HorizontalAlignment="Right" VerticalAlignment="Top"
                      Width="26" Height="26" Margin="0,-2,-26,0" Click="Copy_Click"
                      Style="{StaticResource IconButton}">
                <Path Data="M3,1 L11,1 L11,3 L3,3 Z M1,3 L9,3 L9,13 L1,13 Z"
                      Fill="Transparent" Stroke="{StaticResource Dim}" StrokeThickness="1.2"
                      Width="14" Height="14" Stretch="Uniform"/>
              </Button>
            </Grid>
          </Border>

          <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0">
            <Button x:Name="CopyButton" Style="{StaticResource FlatButton}" Content="Копировать" Width="140" Click="Copy_Click"/>
            <Button x:Name="PauseButton" Style="{StaticResource FlatButton}" Content="Пауза" Width="104" Margin="10,0,0,0" Click="Pause_Click"/>
            <Button x:Name="TunnelButton" Style="{StaticResource FlatButton}" Content="Новый туннель" Width="150" Margin="10,0,0,0" Click="Tunnel_Click"/>
          </StackPanel>

          <Border Grid.Row="3" Background="{StaticResource Panel}" CornerRadius="10" Padding="14,12" Margin="0,14,0,0">
            <StackPanel>
              <TextBlock x:Name="StateLine" FontSize="13" Text="запуск" />
              <TextBlock x:Name="CountLine" FontSize="12" Foreground="{StaticResource Dim}" Margin="0,6,0,0"/>
              <TextBlock x:Name="UptimeLine" FontSize="12" Foreground="{StaticResource Dim}" Margin="0,4,0,0"/>
            </StackPanel>
          </Border>

          <!-- Нижняя часть: то, что нужно рядом с ключом, но не каждый день. -->
          <StackPanel Grid.Row="4" Margin="4,16,0,0">
            <TextBlock Text="Сервис" FontSize="12" Foreground="{StaticResource Dim}" Margin="0,0,0,8"/>
            <UniformGrid Columns="2" HorizontalAlignment="Left">
              <Button x:Name="PromptButton" Style="{StaticResource FlatButton}" Content="Промпт" Width="215" Height="32"
                      HorizontalAlignment="Left" Click="Prompt_Click"/>
              <Button x:Name="CheckButton" Style="{StaticResource FlatButton}" Content="Проверить связь" Width="215" Height="32"
                      HorizontalAlignment="Left" Margin="10,0,0,0" Click="Check_Click"/>
              <Button x:Name="DataButton" Style="{StaticResource FlatButton}" Content="Папка данных" Width="215" Height="32"
                      HorizontalAlignment="Left" Margin="0,8,0,0" Click="Data_Click"/>
              <Button x:Name="LogButton" Style="{StaticResource FlatButton}" Content="Журнал в файле" Width="215" Height="32"
                      HorizontalAlignment="Left" Margin="10,8,0,0" Click="Log_Click"/>
            </UniformGrid>
            <TextBlock x:Name="ServiceHint" FontSize="11.5" Foreground="{StaticResource Dim}" Margin="0,10,0,0"
                       TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>

        <Grid Grid.Column="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="Логги" FontSize="12" Foreground="{StaticResource Dim}" Margin="4,0,0,8"/>
          <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="10" Padding="6,8">
            <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Focusable="False">
              <ScrollViewer.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}"/>
              </ScrollViewer.Resources>
              <ItemsControl x:Name="LogList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Line}" Foreground="{Binding Tone}"
                               FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                               TextWrapping="Wrap" Margin="6,1,10,1"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
